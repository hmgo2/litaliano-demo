# Copiar valores a Variables del hosting, no subir archivos con contraseñas.
HOST=0.0.0.0
# Railway entrega PORT automáticamente. No fijarlo allí.
PORT=3000
DEMO=true
DATA_DIR=/data
SECURE_COOKIES=true
# REEMPLAZAR. Usa al menos 14 caracteres. Nunca uses la contraseña de la demo local.
DEMO_PASSWORD=
# SMTP solo si el plan del hosting permite esos puertos. Railway Trial/Hobby no.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_REPLY_TO=
